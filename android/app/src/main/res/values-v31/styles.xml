<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 et plus : écran de lancement du système, noir et sans
         icône (le logo est ensuite dessiné et animé par l'appli) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <!-- Thème derrière l'appli une fois lancée : noir aussi -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
